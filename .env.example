# Generate a value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRIAGE_API_KEY=replace-with-a-random-secret-at-least-24-characters
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/tickets.db
# rules = deterministic offline classification; openai = actual paid LLM requests.
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
